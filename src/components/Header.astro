---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "#highlights", label: "Highlights" },
  { href: "#versioning", label: "Case study" },
  { href: "#ai", label: "AI workflow" },
  { href: "#changelog", label: "Changelog" },
  { href: "#hello", label: "Say hello" },
];
---

<header class="wrap header">
  <a href="#top" class="logo">aditya<span>.</span>jamuar</a>
  <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
  </nav>
  <div class="toggle"><ThemeToggle /></div>
</header>

<style>
  .header {
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .logo span {
    color: var(--accent);
  }

  .toggle {
    margin-left: auto;
  }

  nav {
    order: 3;
    flex-basis: 100%;
  }

  @media (min-width: 720px) {
    nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }

    .toggle {
      margin-left: 0;
    }
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    font-size: 15px;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
