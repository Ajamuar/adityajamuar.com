<style>
  .theme-toggle {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    padding: 0;
  }

  .theme-toggle:hover {
    border-color: var(--accent-edge);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme="light"]) .icon-sun {
