---
import { filters, releases } from "../data/site";

const toneVar = {
  accent: "var(--accent)",
  accent2: "var(--accent-2)",
  muted: "var(--muted)",
} as const;
---

<section id="changelog" class="wrap section" aria-labelledby="log-title">
  <div class="section-head">
    <p class="kicker">CHANGELOG.md</p>
    <h2 id="log-title" class="h2">Release notes, 2015 → now</h2>
  </div>

  <div class="filters" role="group" aria-label="Filter releases" data-filters hidden>
    {filters.map((f) => (
      <button type="button" class="chip" data-filter={f.id} aria-pressed={f.id === "all" ? "true" : "false"}>
        {f.label}
      </button>
    ))}
  </div>
  <p class="count" aria-live="polite" data-count>Showing {releases.length} of {releases.length} releases</p>

  <ol class="releases">
    {releases.map((r) => (
      <li class="release" data-cats={r.cats.join(" ")}>
        <div class="tag">
          <span class="version" style={`color: ${toneVar[r.tone]}`}>{r.version}</span>
          <span class="dates">{r.dates}</span>
        </div>
        <div class="content">
          <h3>
            {r.company} <span>· {r.role}</span>
          </h3>
          <ul>
            {r.items.map((item) => (
              <li>
                <span class="plus" aria-hidden="true">+</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .filters[hidden] {
    display: none;
  }

  .chip {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font: 500 15px var(--font-sans);
    cursor: pointer;
  }

  .chip:hover {
    border-color: var(--accent-edge);
  }

  .chip[aria-pressed="true"] {
    background: var(--accent-fill);
    border-color: var(--accent-edge);
    color: var(--on-accent);
    font-weight: 600;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .releases {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .release {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface-2);
  }

  .release[hidden] {
    display: none;
  }

  .tag {
    flex: 0 0 180px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .version {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 600;
  }

  .dates {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .content {
    flex: 999 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h3 {
    font-size: 22px;
    line-height: 1.3;
  }

  h3 span {
    font-weight: 400;
    color: var(--muted);
  }

  .content ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .content li {
    display: flex;
    gap: 12px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-item);
  }

  .plus {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--accent);
  }
</style>

<script>
  import { initChangelogFilter } from "../scripts/changelog";
  initChangelogFilter();
</script>
