---
import { hero } from "../data/site";

const films = [
  { theme: "light", src: "/media/bots-build-a-world.mp4?v=2", poster: "/media/bots-build-a-world-poster.jpg?v=2" },
  { theme: "dark", src: "/media/bots-build-a-world-dark.mp4", poster: "/media/bots-build-a-world-dark-poster.jpg" },
];
---

<section id="top" class="wrap hero" aria-labelledby="hero-title">
  <p class="prompt">
    {hero.prompt.command} <span class="hl">{hero.prompt.version}</span> {hero.prompt.head}<span class="cursor" aria-hidden="true">▍</span>
  </p>

  <figure class="hero-film" data-hero-film>
    <h1 id="hero-title" class="hero-title">
      {hero.title} <span>{hero.subtitle}</span>
    </h1>
    <div class="film-stage">
      {films.map(({ theme, src, poster }) => (
        <video
          id={`hero-animation-${theme}`}
          class="film"
          data-film-theme={theme}
          width="1280"
          height="720"
          poster={poster}
          data-src={src}
          muted
          playsinline
          preload="none"
          disablepictureinpicture
          aria-hidden="true"
          tabindex="-1"
        ></video>
      ))}
    </div>
    <figcaption class="film-caption">
      <p class="sr-only">{hero.animation.description}</p>
      <button
        type="button"
        class="film-control"
        data-film-control
        data-state="idle"
        data-play-label={hero.animation.play}
        data-pause-label={hero.animation.pause}
        data-replay-label={hero.animation.replay}
        aria-controls="hero-animation-light"
        hidden
      >
        <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
        <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
        <svg class="icon-replay" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6" /></svg>
        <span data-film-label>{hero.animation.play}</span>
      </button>
    </figcaption>
  </figure>

  <div class="hero-details">
    <p class="intro">{hero.intro}</p>
    <aside class="now">
      <span class="tag">{hero.contact.status}</span>
      <p>{hero.contact.body}</p>
      <a href="#hello">{hero.contact.action}<span aria-hidden="true"> ↗</span></a>
    </aside>
  </div>
</section>

<script>
  import { initHeroAnimation } from "../scripts/hero-animation";
  initHeroAnimation();
</script>

<style>
  .hero {
    padding-top: clamp(32px, 4vw, 56px);
    padding-bottom: 32px;
  }

  .prompt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    overflow-wrap: anywhere;
    text-align: center;
  }

  .hl,
  .cursor {
    color: var(--accent);
  }

  .cursor {
    animation: blink 1.1s steps(1) 5;
  }

  .hero-film {
    margin: 0 0 28px;
  }

  .film-stage {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 2.45;
    background: var(--bg);
    mask-image: linear-gradient(to bottom, #000 88%, transparent);
  }

  .film {
    display: none;
    position: absolute;
    width: 100%;
    height: auto;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .film[data-film-theme="dark"] {
    display: block;
  }

  :global([data-theme="dark"]) .film-stage {
    mask-image:
      linear-gradient(to bottom, transparent, #000 5%, #000 88%, transparent),
      linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }

  :global([data-theme="light"]) .film[data-film-theme="dark"] {
    display: none;
  }

  :global([data-theme="light"]) .film[data-film-theme="light"] {
    display: block;
    filter: brightness(1.04);
    mix-blend-mode: multiply;
  }

  .film-caption {
    display: flex;
    justify-content: center;
    min-height: 44px;
    margin-top: -12px;
    position: relative;
  }

  .hero-title {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .film-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 12px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 12px var(--font-mono);
    cursor: pointer;
  }

  .film-control[hidden],
  .film-control svg {
    display: none;
  }

  .film-control:hover {
    color: var(--text);
  }

  .film-control[data-state="idle"] .icon-play,
  .film-control[data-state="paused"] .icon-play,
  .film-control[data-state="playing"] .icon-pause,
  .film-control[data-state="ended"] .icon-replay {
    display: block;
  }

  .hero-details {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: 56px;
    align-items: start;
  }

  .intro {
    font-size: clamp(1.05rem, 1.4vw, 1.125rem);
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 65ch;
  }

  .now {
    border-left: 1px solid var(--border);
    padding-left: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent-fill);
    padding: 3px 9px;
    border-radius: 999px;
  }

  .now p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .now a {
    font-size: 14px;
    font-weight: 500;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .hero-details {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .now {
      padding: 20px 0 0;
      border-left: 0;
      border-top: 1px solid var(--border);
      max-width: 65ch;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 28px;
      padding-bottom: 16px;
    }

    .prompt {
      font-size: 11px;
      line-height: 1.7;
    }

    .hero-film {
      margin-top: 24px;
      margin-bottom: 24px;
    }

    .film-stage {
      margin-inline: -24px;
      aspect-ratio: 2;
      mask-image: linear-gradient(to bottom, #000 88%, transparent);
    }

    .film {
      width: 175%;
      max-width: none;
      top: 0;
      left: 50%;
      /* Keep the centered illustration, with the baked-in title above the crop. */
      transform: translate(-50%, -34%);
    }

    .film-caption {
      flex-direction: column;
      align-items: center;
      margin-top: 0;
    }

    .hero-title {
      position: static;
      width: auto;
      height: auto;
      max-width: 18ch;
      margin: 0 auto 16px;
      text-align: center;
      text-wrap: balance;
      overflow: visible;
      clip-path: none;
      white-space: normal;
      font-size: clamp(1.75rem, 7.7vw, 2.4rem);
      line-height: 1.12;
      letter-spacing: -0.035em;
      font-weight: 700;
    }

    .hero-title span {
      display: block;
      margin-top: 10px;
      font-size: 0.6em;
      line-height: 1.4;
      letter-spacing: -0.01em;
      font-weight: 400;
      color: var(--text-soft);
    }

    .film-control {
      padding: 0;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
