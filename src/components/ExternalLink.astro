---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { href: string };

const { href, rel, class: className, ...rest } = Astro.props;
const relValue = ["noopener", "noreferrer", rel].filter(Boolean).join(" ");
---

<a href={href} target="_blank" rel={relValue} class:list={["ext", className]} {...rest}>
  <slot />
  <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M7 17L17 7M9 7h8v8"></path>
  </svg>
  <span class="sr-only">(opens in a new tab)</span>
</a>

<style>
  .ext {
    gap: 6px;
  }

  .ext-icon {
    opacity: 0.7;
  }
</style>
