---
import { practices } from "../data/site";

const icons: Record<string, { stroke: string; paths: string }> = {
  orchestrate: {
    stroke: "var(--accent)",
    paths: '<circle cx="12" cy="5" r="3"></circle><circle cx="5" cy="19" r="3"></circle><circle cx="19" cy="19" r="3"></circle><path d="M12 8v4M12 12l-5 4.5M12 12l5 4.5"></path>',
  },
  heal: {
    stroke: "var(--accent-2)",
    paths: '<path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 3v6h-6"></path>',
  },
  context: {
    stroke: "var(--accent)",
    paths: '<path d="M4 4h16v6H4zM4 14h7v6H4zM15 14h5v6h-5z"></path>',
  },
  guard: {
    stroke: "var(--accent-2)",
    paths: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"></path><path d="M9 12l2 2 4-4"></path>',
  },
};
---

<section id="ai" class="wrap section" aria-labelledby="ai-title">
  <div class="section-head">
    <p class="kicker">// how I ship now</p>
    <h2 id="ai-title" class="h2">Agents on the team, humans on the merge button.</h2>
    <p class="lede">
      I treat AI agents like a well-run squad: clear roles, shared context, and guardrails that keep a person accountable for what ships.
    </p>
  </div>
  <ul class="grid" style="--min: 250px">
    {practices.map((p) => (
      <li class="card">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke={icons[p.icon].stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[p.icon].paths} />
        <h3>{p.title}</h3>
        <p>{p.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .card {
    padding: 24px;
    border-radius: 16px;
  }

  h3 {
    font-size: 20px;
  }

  p:not(.kicker):not(.lede) {
    color: var(--text-soft);
    font-size: 15px;
    line-height: 1.6;
  }
</style>
