---
import { highlights } from "../data/site";
---

<section id="highlights" class="wrap section" aria-labelledby="hl-title">
  <div class="section-head">
    <p class="kicker">// greatest hits</p>
    <h2 id="hl-title" class="h2">The biggest things I've shipped</h2>
  </div>
  <ul class="grid" style="--min: 320px">
    {highlights.map((h) => (
      <li class:list={["card", { featured: h.featured }]}>
        <span class="meta">{h.org} · {h.area}</span>
        {h.figure && (
          <p class="figure">
            {h.figure}
            {h.figureUnit && <span class="unit"> {h.figureUnit}</span>}
          </p>
        )}
        <h3 class:list={{ small: Boolean(h.figure) }}>{h.title}</h3>
        <p class="body">{h.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .meta {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-2);
  }

  .figure {
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .unit {
    font-size: 22px;
  }

  h3 {
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  h3.small {
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .featured {
    background: var(--accent-fill);
    border-color: var(--accent-edge);
    color: var(--on-accent);
  }

  .featured .meta,
  .featured .body {
    color: var(--on-accent);
  }
</style>
